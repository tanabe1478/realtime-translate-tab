# Local faster-whisper sidecar
WHISPER_URL=http://127.0.0.1:8790
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_HOST=127.0.0.1
WHISPER_PORT=8790

# ChatGPT subscription translation (run `pnpm auth:openai` first)
OPENAI_TRANSLATE_MODEL=gpt-6-luna

HOST=127.0.0.1
PORT=8787
