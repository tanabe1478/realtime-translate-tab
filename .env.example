# Local faster-whisper sidecar
WHISPER_URL=http://127.0.0.1:8790
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_HOST=127.0.0.1
WHISPER_PORT=8790
# Optional supported Python executable for first-time venv creation.
# WHISPER_PYTHON=/absolute/path/to/python3.12

# Translation AND automatic topic/glossary generation use the same selection.
# openai = existing ChatGPT OAuth login OR an explicitly configured OpenAI key.
# opencode-go = OpenCode Go key. Never automatically falls back to the other.
# Restart the server after changing selection or credentials.
TRANSLATION_PROVIDER=openai

# OpenAI: run `pnpm auth:openai` for ChatGPT login (saved in data/auth.json).
# OPENAI_API_KEY is optional, for OpenAI API billing instead of subscription login.
OPENAI_TRANSLATE_MODEL=gpt-6-luna
# OPENAI_API_KEY=

# OpenCode Go: intended for coding agents; confirm this app's use is permitted.
# Keep your real key in .env only. Do not paste it in chat or commit it.
OPENCODE_API_KEY=
OPENCODE_TRANSLATE_MODEL=glm-5.3-flash

HOST=127.0.0.1
PORT=8787
